<h1>Produtos</h1>

<a href="/produtos/novo">Novo produto</a>
|
<a href="/categorias">Ver categorias</a>
|
<a href="/produtos/buscar">Pesquisar</a>

<br><br>

<label>Filtrar por categoria:</label>
<select id="filtroCategoria">
    <% categorias.forEach(c => { %>
        <option value="<%= c.id %>"><%= c.nome %></option>
    <% }) %>
</select>
<button type="button" onclick="filtrar()">Filtrar</button>

<script>
function filtrar() {
    const id = document.getElementById('filtroCategoria').value;
    window.location.href = '/produtos/categoria/' + id;
}
</script>

<table border="1">
    <tr>
        <th>Nome</th>
        <th>Preço</th>
        <th>Quantidade</th>
        <th>Categoria</th>
        <th>Ações</th>
    </tr>

    <% produtos.forEach(p => { %>

        <tr>
            <td><%= p.nome %></td>
            <td><%= p.preco %></td>
            <td><%= p.quantidade %></td>
            <td><%= p.Categoria ? p.Categoria.nome : 'Sem categoria' %></td>

            <td>
                <a href="/produtos/<%= p.id %>/editar">
                    Editar
                </a>

                <form
                    action="/produtos/<%= p.id %>/deletar"
                    method="POST"
                    style="display:inline"
                >
                    <button type="submit">
                        Excluir
                    </button>
                </form>
            </td>
        </tr>

    <% }) %>

</table>
