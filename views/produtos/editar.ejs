<h1>Editar produto</h1>

<form action="/produtos/<%= produto.id %>" method="POST">

    <label>Nome:</label>
    <input
        type="text"
        name="nome"
        value="<%= produto.nome %>"
    >

    <br>

    <label>Preço:</label>
    <input
        type="number"
        name="preco"
        step="0.01"
        value="<%= produto.preco %>"
    >

    <br>

    <label>Quantidade:</label>
    <input
        type="number"
        name="quantidade"
        value="<%= produto.quantidade %>"
    >

    <br>

    <label>Categoria:</label>
    <select name="categoriaId">
        <option value="" <%= !produto.categoriaId ? 'selected' : '' %>>Sem categoria</option>

        <% categorias.forEach(c => { %>
            <option
                value="<%= c.id %>"
                <%= String(produto.categoriaId) === String(c.id) ? 'selected' : '' %>
            ><%= c.nome %></option>
        <% }) %>
    </select>

    <br>

    <button type="submit">
        Atualizar
    </button>

</form>
